*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #0d0d0f;
  --surface: #16161a;
  --surface-2: #1e1e24;
  --border: #2a2a35;
  --border-focus: #6c63ff;
  --text-primary: #f0f0f5;
  --text-secondary: #8888a0;
  --accent: #6c63ff;
  --accent-glow: rgba(108, 99, 255, 0.3);
  --success: #22c55e;
  --error: #ef4444;
  --error-bg: rgba(239, 68, 68, 0.08);
  --font-display: 'DM Serif Display', Georgia, serif;
  --font-body: 'DM Sans', system-ui, sans-serif;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg);
  color: var(--text-primary);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-x: hidden;
}

#root {
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
